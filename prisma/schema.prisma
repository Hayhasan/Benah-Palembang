generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  TAKEN_DOWN
  ARCHIVED
}

model User {
  id                  String           @id @default(uuid()) @db.Uuid
  name                String           @db.VarChar(160)
  username            String           @unique @db.VarChar(30)
  email               String           @unique @db.VarChar(255)
  originalEmail       String?          @db.VarChar(255)
  password            String           @db.Text
  role                UserRole         @default(USER)
  avatarUrl           String?          @db.Text
  bannerUrl           String?          @db.Text
  bio                 String?          @db.Text
  whatsappCountryCode String?          @db.VarChar(8)
  whatsappNumber      String?          @db.VarChar(32)
  instagramUrl        String?          @db.Text
  xUrl                String?          @db.Text
  linkedinUrl         String?          @db.Text
  isBanned            Boolean          @default(false)
  bannedAt            DateTime?        @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?        @db.Timestamptz(6)
  authoredArticles    Article[]        @relation("ArticleAuthor")
  ownedEvents         Event[]          @relation("EventOwner")
  activityLogs        ActivityLog[]    @relation("UserActivityLogs")

  @@index([role, deletedAt, createdAt])
  @@index([isBanned, deletedAt])
  @@map("users")
}

enum WebsiteArticleSectionTheme {
  DEFAULT
  RED
  OFF_WHITE
  DARK
}

enum WebsiteArticleSectionLayout {
  STANDARD
  FEATURED_FIRST
}

enum WebsiteExploreCountSource {
  MANUAL
  ARTICLE_CATEGORY
  EVENT
  NONE
}

enum WebsiteCollaborationPlatform {
  YOUTUBE
  INSTAGRAM
  TIKTOK
  FACEBOOK
  X
}

enum WebsiteFooterConnectPlatform {
  INSTAGRAM
  WHATSAPP
  YOUTUBE
  TIKTOK
  LINKEDIN
  X
  FACEBOOK
  MAIL
  WEBSITE
}

model WebsiteContent {
  id                    Int                     @id @default(autoincrement())
  key                   String                  @unique @db.VarChar(100)
  originalKey           String?                 @db.VarChar(100)
  aboutEyebrow          String                  @db.VarChar(160)
  aboutEstablishedText  String                  @db.VarChar(160)
  aboutTitle            String                  @db.VarChar(255)
  aboutDescription      String                  @db.Text
  aboutClosingText      String                  @db.VarChar(255)
  exploreEyebrow        String                  @db.VarChar(160)
  exploreTitle          String                  @db.VarChar(255)
  teamEyebrow           String                  @db.VarChar(160)
  teamTitle             String                  @db.VarChar(255)
  teamDescription       String                  @db.Text
  ctaEyebrow            String                  @db.VarChar(160)
  ctaTitle              String                  @db.VarChar(255)
  ctaDescription        String                  @db.Text
  ctaButtonLabel        String                  @db.VarChar(100)
  ctaButtonUrl          String                  @db.Text
  ctaBackgroundImageUrl String                  @default("https://images.pexels.com/photos/14616555/pexels-photo-14616555.jpeg?auto=compress&cs=tinysrgb&w=1200&h=800&fit=crop") @db.Text
  ctaContactLabel       String                  @default("Hubungi Kami") @db.VarChar(100)
  ctaContactEmail       String                  @default("kolaborasi@benahpalembang.id") @db.VarChar(320)
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime?               @db.Timestamptz(6)
  heroSlides            WebsiteHeroSlide[]
  exploreItems          WebsiteExploreItem[]
  articleSections       WebsiteArticleSection[]
  teamMembers           WebsiteTeamMember[]

  @@index([deletedAt])
  @@map("website_contents")
}

model WebsiteHeroSlide {
  id               Int            @id @default(autoincrement())
  websiteContentId Int
  imageUrl         String         @db.Text
  imageAlt         String         @db.VarChar(255)
  eyebrow          String         @db.VarChar(160)
  title            String         @db.VarChar(255)
  description      String         @db.Text
  buttonLabel      String         @db.VarChar(100)
  buttonUrl        String         @db.Text
  position         Int
  isVisible        Boolean        @default(true)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?      @db.Timestamptz(6)
  websiteContent   WebsiteContent @relation(fields: [websiteContentId], references: [id])

  @@index([websiteContentId, deletedAt, position])
  @@map("website_hero_slides")
}

model WebsiteExploreItem {
  id                    Int                       @id @default(autoincrement())
  websiteContentId      Int
  label                 String                    @db.VarChar(160)
  linkUrl               String                    @db.Text
  countSource           WebsiteExploreCountSource @default(MANUAL)
  countArticleSectionId Int?
  countLabel            String?                   @db.VarChar(60)
  storyCount            Int?
  position              Int
  isVisible             Boolean                   @default(true)
  createdAt             DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                  @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime?                 @db.Timestamptz(6)
  websiteContent        WebsiteContent            @relation(fields: [websiteContentId], references: [id])
  countArticleSection   WebsiteArticleSection?    @relation("WebsiteExploreItemArticleSection", fields: [countArticleSectionId], references: [id])

  @@index([websiteContentId, deletedAt, position])
  @@index([countArticleSectionId])
  @@map("website_explore_items")
}

model WebsiteArticleSection {
  id                          Int                         @id @default(autoincrement())
  websiteContentId            Int
  sectionKey                  String                      @db.VarChar(160)
  originalSectionKey          String?                     @db.VarChar(160)
  articleCategorySlug         String                      @db.VarChar(160)
  originalArticleCategorySlug String?                     @db.VarChar(160)
  eyebrow                     String                      @db.VarChar(160)
  title                       String                      @db.VarChar(255)
  description                 String                      @db.Text
  backgroundImageUrl          String                      @db.Text
  linkLabel                   String                      @db.VarChar(100)
  categoryHeroImageUrl        String                      @db.Text
  categoryHeroImageAlt        String                      @db.VarChar(255)
  categoryHeroTitle           String                      @db.VarChar(255)
  categoryHeroDescription     String                      @db.Text
  theme                       WebsiteArticleSectionTheme  @default(DEFAULT)
  layout                      WebsiteArticleSectionLayout @default(STANDARD)
  maxItems                    Int                         @default(4)
  position                    Int
  isVisible                   Boolean                     @default(true)
  createdAt                   DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime                    @updatedAt @db.Timestamptz(6)
  deletedAt                   DateTime?                   @db.Timestamptz(6)
  articles                    Article[]
  pins                        WebsiteArticleSectionPin[]
  heroSlides                  WebsiteArticleSectionHeroSlide[]
  exploreItems                WebsiteExploreItem[]        @relation("WebsiteExploreItemArticleSection")
  websiteContent              WebsiteContent              @relation(fields: [websiteContentId], references: [id])

  @@unique([websiteContentId, sectionKey])
  @@unique([websiteContentId, articleCategorySlug], map: "website_article_sections_content_category_slug_key")
  @@index([websiteContentId, deletedAt, position])
  @@map("website_article_sections")
}

model WebsiteArticleSectionPin {
  id                      Int                   @id @default(autoincrement())
  websiteArticleSectionId Int
  articleId               Int                   @unique
  position                Int
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(6)
  websiteArticleSection   WebsiteArticleSection @relation(fields: [websiteArticleSectionId], references: [id])
  article                 Article               @relation(fields: [articleId], references: [id])

  @@unique([websiteArticleSectionId, position])
  @@index([websiteArticleSectionId, position])
  @@map("website_article_section_pins")
}

model WebsiteArticleSectionHeroSlide {
  id                      Int                   @id @default(autoincrement())
  websiteArticleSectionId Int
  imageUrl                String                @db.Text
  imageAlt                String                @db.VarChar(255)
  label                   String                @db.VarChar(160)
  title                   String                @db.VarChar(255)
  description             String                @db.Text
  photographerName        String?               @db.VarChar(160)
  position                Int
  isVisible               Boolean               @default(true)
  createdAt               DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @db.Timestamptz(6)
  deletedAt               DateTime?             @db.Timestamptz(6)
  websiteArticleSection   WebsiteArticleSection @relation(fields: [websiteArticleSectionId], references: [id])

  @@index([websiteArticleSectionId, deletedAt, position])
  @@map("website_article_section_hero_slides")
}

model WebsiteTeamMember {
  id               Int            @id @default(autoincrement())
  websiteContentId Int
  name             String         @db.VarChar(160)
  role             String         @db.VarChar(160)
  imageUrl         String         @db.Text
  bio              String         @db.Text
  position         Int
  isVisible        Boolean        @default(true)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?      @db.Timestamptz(6)
  websiteContent   WebsiteContent @relation(fields: [websiteContentId], references: [id])

  @@index([websiteContentId, deletedAt, position])
  @@map("website_team_members")
}

model WebsiteCollaborationContent {
  id              Int                                  @id @default(autoincrement())
  key             String                               @unique @db.VarChar(100)
  originalKey     String?                              @db.VarChar(100)
  contactEmail    String                               @db.VarChar(255)
  contactPhone    String                               @db.VarChar(50)
  emailUrl        String                               @db.Text
  whatsappUrl     String                               @db.Text
  createdAt       DateTime                             @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                             @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?                            @db.Timestamptz(6)
  heroSlides      WebsiteCollaborationHeroSlide[]
  partnerLogos    WebsiteCollaborationPartnerLogo[]
  partnerContents WebsiteCollaborationPartnerContent[]

  @@index([deletedAt])
  @@map("website_collaboration_contents")
}

model WebsiteCollaborationHeroSlide {
  id                     Int                         @id @default(autoincrement())
  collaborationContentId Int
  imageUrl               String                      @db.Text
  imageAlt               String                      @db.VarChar(255)
  title                  String                      @db.VarChar(255)
  description            String                      @db.Text
  position               Int
  isVisible              Boolean                     @default(true)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?                   @db.Timestamptz(6)
  collaborationContent   WebsiteCollaborationContent @relation(fields: [collaborationContentId], references: [id])

  @@index([collaborationContentId, deletedAt, position])
  @@map("website_collaboration_hero_slides")
}

model WebsiteCollaborationPartnerLogo {
  id                     Int                         @id @default(autoincrement())
  collaborationContentId Int
  name                   String                      @db.VarChar(160)
  imageUrl               String                      @db.Text
  position               Int
  isVisible              Boolean                     @default(true)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?                   @db.Timestamptz(6)
  collaborationContent   WebsiteCollaborationContent @relation(fields: [collaborationContentId], references: [id])

  @@index([collaborationContentId, deletedAt, position])
  @@map("website_collaboration_partner_logos")
}

model WebsiteCollaborationPartnerContent {
  id                     Int                          @id @default(autoincrement())
  collaborationContentId Int
  title                  String?                      @db.VarChar(255)
  platform               WebsiteCollaborationPlatform
  contentUrl             String                       @db.Text
  position               Int
  isVisible              Boolean                      @default(true)
  createdAt              DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                     @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?                    @db.Timestamptz(6)
  collaborationContent   WebsiteCollaborationContent  @relation(fields: [collaborationContentId], references: [id])

  @@index([collaborationContentId, deletedAt, position])
  @@map("website_collaboration_partner_contents")
}

model WebsiteHeaderFooterContent {
  id                   Int                        @id @default(autoincrement())
  key                  String                     @unique @db.VarChar(100)
  originalKey          String?                    @db.VarChar(100)
  logoImageUrl         String                     @db.Text
  footerLogoImageUrl   String?                    @db.Text
  footerLogoImageAlt   String?                    @db.VarChar(255)
  footerTitle          String?                    @db.VarChar(255)
  footerDescription    String                     @db.Text
  footerCreatorText    String                     @default("The content for Benah Palembang was created by the people of Palembang for the people of Palembang.") @db.Text
  copyrightText        String                     @db.VarChar(255)
  headerBgColor        String                     @default("#ffffff") @db.VarChar(9)
  headerTextColor      String                     @default("#000000") @db.VarChar(9)
  headerButtonColor    String                     @default("#000000") @db.VarChar(9)
  footerBgColor        String                     @default("#000000") @db.VarChar(9)
  footerTextColor      String                     @default("#ffffff") @db.VarChar(9)
  createdAt            DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                   @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?                  @db.Timestamptz(6)
  footerConnectLinks   WebsiteFooterConnectLink[]

  @@index([deletedAt])
  @@map("website_header_footer_contents")
}

model WebsiteFooterConnectLink {
  id                    Int                          @id @default(autoincrement())
  headerFooterContentId Int
  platform              WebsiteFooterConnectPlatform @default(WEBSITE)
  linkUrl               String                       @db.Text
  position              Int
  isVisible             Boolean                      @default(true)
  createdAt             DateTime                     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                     @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime?                    @db.Timestamptz(6)
  headerFooterContent   WebsiteHeaderFooterContent   @relation(fields: [headerFooterContentId], references: [id])

  @@index([headerFooterContentId, deletedAt, position])
  @@map("website_footer_connect_links")
}

model WebsiteAgendaContent {
  id              Int       @id @default(autoincrement())
  key             String    @unique @db.VarChar(100)
  originalKey     String?   @db.VarChar(100)
  heroImageUrl    String    @db.Text
  heroImageAlt    String    @db.VarChar(255)
  heroEyebrow     String    @db.VarChar(160)
  heroTitle       String    @db.VarChar(255)
  heroDescription String    @db.Text
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime? @db.Timestamptz(6)

  @@index([deletedAt])
  @@map("website_agenda_contents")
}

model Event {
  id              Int           @id @default(autoincrement())
  ownerId         String        @db.Uuid
  slug            String        @unique @db.VarChar(180)
  originalSlug    String?       @db.VarChar(180)
  title           String        @db.VarChar(255)
  description     String        @db.Text
  content         String        @db.Text
  bannerUrl       String        @db.Text
  additionalBannerUrls String[] @default([])
  category        String        @db.VarChar(100)
  startsAt        DateTime      @db.Timestamptz(6)
  endsAt          DateTime?     @db.Timestamptz(6)
  location        String        @db.VarChar(255)
  organizer       String        @db.VarChar(255)
  photographer    String?       @db.VarChar(255)
  registrationUrl String?       @db.Text
  whatsappUrl     String        @db.Text
  views           Int           @default(0)
  status          ContentStatus @default(DRAFT)
  moderationNote  String?       @db.Text
  submittedAt     DateTime?     @db.Timestamptz(6)
  publishedAt     DateTime?     @db.Timestamptz(6)
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(6)
  deletedAt       DateTime?     @db.Timestamptz(6)
  owner           User             @relation("EventOwner", fields: [ownerId], references: [id])
  tags            EventTag[]
  dailyViews      EventDailyView[]

  @@index([ownerId, deletedAt, updatedAt])
  @@index([status, deletedAt, startsAt])
  @@map("events")
}

model EventTag {
  id        Int       @id @default(autoincrement())
  eventId   Int
  label     String    @db.VarChar(80)
  position  Int
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  event     Event     @relation(fields: [eventId], references: [id])

  @@index([eventId, deletedAt, position])
  @@map("event_tags")
}

model Article {
  id                      Int                        @id @default(autoincrement())
  authorId                String                     @db.Uuid
  websiteArticleSectionId Int
  slug                    String                     @unique @db.VarChar(180)
  originalSlug            String?                    @db.VarChar(180)
  title                   String                     @db.VarChar(255)
  excerpt                 String                     @db.Text
  content                 String                     @db.Text
  label                   String?                    @db.VarChar(160)
  coverImageUrl           String                     @db.Text
  additionalBannerUrls    String[]                   @default([])
  photographer            String?                    @db.VarChar(160)
  additionalPhotographers String[]                   @default([])
  readingTime             Int
  isFeatured              Boolean                    @default(false)
  views                   Int                        @default(0)
  status                  ContentStatus              @default(DRAFT)
  venueName               String?                    @db.VarChar(255)
  venueAddress            String?                    @db.Text
  venuePriceLevel         Int?                       @default(1)
  venueOpenDays           String?                    @db.VarChar(100)
  venueOpenHours          String?                    @db.VarChar(100)
  venueFeatures           String[]                   @default([])
  venueContact            String?                    @db.VarChar(100)
  moderationNote          String?                    @db.Text
  submittedAt             DateTime?                  @db.Timestamptz(6)
  publishedAt             DateTime?                  @db.Timestamptz(6)
  createdAt               DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                   @updatedAt @db.Timestamptz(6)
  deletedAt               DateTime?                  @db.Timestamptz(6)
  author                  User                       @relation("ArticleAuthor", fields: [authorId], references: [id])
  websiteArticleSection   WebsiteArticleSection      @relation(fields: [websiteArticleSectionId], references: [id])
  tags                    ArticleTag[]
  landingPins             WebsiteArticleSectionPin[]
  dailyViews              ArticleDailyView[]

  @@index([authorId, deletedAt, updatedAt])
  @@index([websiteArticleSectionId, status, deletedAt, publishedAt])
  @@map("articles")
}

model ArticleTag {
  id        Int       @id @default(autoincrement())
  articleId Int
  label     String    @db.VarChar(80)
  position  Int
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)
  deletedAt DateTime? @db.Timestamptz(6)
  article   Article   @relation(fields: [articleId], references: [id])

  @@index([articleId, deletedAt, position])
  @@map("article_tags")
}


enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  TAKEDOWN
  RESTORE
  ARCHIVE
  BAN
  UNBAN
  CHANGE_ROLE
}

enum ActivityModule {
  AUTH
  PROFILE
  ACCOUNT
  WEBSITE
  ARTICLE
  EVENT
  CONTENT
}

model ActivityLog {
  id          Int            @id @default(autoincrement())
  userId      String?        @db.Uuid
  userName    String         @db.VarChar(160)
  userRole    UserRole       @default(USER)
  action      ActivityAction
  module      ActivityModule
  description String         @db.Text
  beforeState Json?          @db.JsonB
  afterState  Json?          @db.JsonB
  ipAddress   String?        @db.VarChar(64)
  userAgent   String?        @db.Text
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  user        User?          @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([module, createdAt])
  @@index([action, createdAt])
  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

model DailyVisit {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@map("daily_visits")
}

model HourlyVisit {
  id        Int      @id @default(autoincrement())
  date      DateTime @db.Date
  hour      Int      @db.SmallInt // 0-23
  count     Int      @default(0)

  @@unique([date, hour])
  @@index([date])
  @@map("hourly_visits")
}

model ArticleDailyView {
  id        Int      @id @default(autoincrement())
  articleId Int
  date      DateTime @db.Date
  count     Int      @default(0)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, date])
  @@index([date])
  @@map("article_daily_views")
}

model EventDailyView {
  id        Int      @id @default(autoincrement())
  eventId   Int
  date      DateTime @db.Date
  count     Int      @default(0)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, date])
  @@index([date])
  @@map("event_daily_views")
}
